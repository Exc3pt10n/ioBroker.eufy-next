{
  "name": "iobroker.eufy-next",
  "version": "0.5.0",
  "description": "ioBroker adapter for Anker eufy devices (cameras, doorbells, locks, sensors, vacuums, lights) based on the new eufy-sdk (eufy v6 cloud)",
  "author": {
    "name": "Exc3pt10n",
    "email": "kontakt@jansesoft.de"
  },
  "homepage": "https://github.com/Exc3pt10n/ioBroker.eufy-next",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "eufy",
    "anker",
    "eufy-security",
    "camera",
    "doorbell",
    "vacuum",
    "smart home"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exc3pt10n/ioBroker.eufy-next.git"
  },
  "bugs": {
    "url": "https://github.com/Exc3pt10n/ioBroker.eufy-next/issues"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit",
    "test:unit": "node --test test/*.test.mjs",
    "test:package": "mocha test/package.js --exit",
    "test": "npm run test:unit && npm run test:package",
    "test:integration": "mocha test/integration.js --exit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@mega-yfue/eufy-sdk": "^0.5.0",
    "ffmpeg-static": "^5.3.0",
    "go2rtc-static": "^1.9.4"
  },
  "devDependencies": {
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.3",
    "@iobroker/types": "^7.0.6",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
