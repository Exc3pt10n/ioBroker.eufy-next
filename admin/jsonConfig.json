{
    "i18n": true,
    "type": "tabs",
    "items": {
        "account": {
            "type": "panel",
            "label": "Account",
            "items": {
                "hdrAccount": {
                    "type": "header",
                    "size": 4,
                    "text": "eufy account"
                },
                "email": {
                    "type": "text",
                    "label": "E-mail",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "newLine": true,
                    "xl": 4
                },
                "password": {
                    "type": "password",
                    "label": "Password",
                    "repeat": false,
                    "visible": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "countryCode": {
                    "type": "text",
                    "label": "Country code of the account",
                    "help": "Two letters, e.g. DE, AT, CH, GB, US — selects the cloud region",
                    "maxLength": 2,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 2,
                    "newLine": true,
                    "xl": 2
                },
                "verifyMethod": {
                    "type": "select",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 2,
                    "label": "Send 2FA code via",
                    "options": [
                        {
                            "value": "email",
                            "label": "E-mail"
                        },
                        {
                            "value": "sms",
                            "label": "SMS"
                        }
                    ],
                    "xl": 2
                },
                "hint": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "text": "Tip: create a second eufy account, share your devices with it in the eufy app and use it here. That way the adapter never logs your phone out.",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "login": {
            "type": "panel",
            "label": "Login (2FA / captcha)",
            "items": {
                "hdrStatus": {
                    "type": "header",
                    "size": 4,
                    "text": "Login status"
                },
                "statusText": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "text": "The instance must be running. Do NOT save the settings while a login is pending — saving restarts the instance and eufy will send a new code.",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "btnStatus": {
                    "type": "textSendTo",
                    "command": "loginStatus",
                    "container": "div",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "hdrCode": {
                    "type": "header",
                    "size": 5,
                    "newLine": true,
                    "text": "Verification code (2FA)"
                },
                "_verifyCode": {
                    "type": "text",
                    "label": "Code from e-mail / SMS",
                    "doNotSave": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "btnCode": {
                    "type": "sendTo",
                    "label": "Submit code",
                    "command": "verifyCode",
                    "jsonData": "{\"code\": \"${data._verifyCode}\"}",
                    "variant": "contained",
                    "showProcess": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "hdrCaptcha": {
                    "type": "header",
                    "size": 5,
                    "newLine": true,
                    "text": "Captcha (only when requested)"
                },
                "captchaImg": {
                    "type": "imageSendTo",
                    "command": "captchaImage",
                    "height": 80,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_captchaAnswer": {
                    "type": "text",
                    "label": "Captcha characters",
                    "doNotSave": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "btnCaptcha": {
                    "type": "sendTo",
                    "label": "Submit captcha",
                    "command": "captcha",
                    "jsonData": "{\"answer\": \"${data._captchaAnswer}\"}",
                    "variant": "contained",
                    "showProcess": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "hdrRelogin": {
                    "type": "header",
                    "size": 5,
                    "newLine": true,
                    "text": "Reset session"
                },
                "btnRelogin": {
                    "type": "sendTo",
                    "label": "Discard session and log in again",
                    "command": "relogin",
                    "confirm": {
                        "text": "This usually requires a new 2FA code. Continue?",
                        "title": "Log in again",
                        "ok": "Yes",
                        "cancel": "Cancel"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "livestream": {
            "type": "panel",
            "label": "Livestream",
            "items": {
                "liveInfo": {
                    "type": "staticText",
                    "xs": 12,
                    "text": "Pressing <serial>.livestream.start pulls the camera's stream through ffmpeg into a go2rtc player (bundled). livestream.url then holds the player page (MSE/HLS/WebRTC, with sound). The stream stops after the maximum duration — battery cameras drain while streaming.",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "liveEnabled": {
                    "type": "checkbox",
                    "newLine": true,
                    "xs": 12,
                    "label": "Offer livestreams for cameras",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "liveHostname": {
                    "type": "text",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "disabled": "!data.liveEnabled",
                    "label": "Hostname / IP of the ioBroker host for player URLs",
                    "help": "Empty = first network address of the host",
                    "xl": 4
                },
                "liveMaxDurationSec": {
                    "type": "number",
                    "min": 0,
                    "max": 3600,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "disabled": "!data.liveEnabled",
                    "label": "Maximum duration (seconds, 0 = unlimited)",
                    "xl": 3
                },
                "liveApiPort": {
                    "type": "port",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "disabled": "!data.liveEnabled",
                    "label": "Player / API port",
                    "xl": 2
                },
                "liveRtspPort": {
                    "type": "port",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "disabled": "!data.liveEnabled",
                    "label": "RTSP port",
                    "xl": 2
                },
                "liveWebrtcPort": {
                    "type": "port",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "disabled": "!data.liveEnabled",
                    "label": "WebRTC port",
                    "xl": 2
                },
                "liveRtspUsername": {
                    "type": "text",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "disabled": "!data.liveEnabled",
                    "label": "RTSP user (optional)",
                    "xl": 3
                },
                "liveRtspPassword": {
                    "type": "password",
                    "repeat": false,
                    "visible": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "disabled": "!data.liveEnabled",
                    "label": "RTSP password",
                    "xl": 3
                },
                "liveSnapshot": {
                    "type": "checkbox",
                    "newLine": true,
                    "xs": 12,
                    "disabled": "!data.liveEnabled",
                    "label": "Save a still from the running stream as snapshot",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "liveHttps": {
                    "type": "checkbox",
                    "newLine": true,
                    "xs": 12,
                    "disabled": "!data.liveEnabled",
                    "label": "Serve the player over HTTPS (needed when embedded in an HTTPS visualisation)",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "liveCertPublic": {
                    "type": "certificate",
                    "certType": "public",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "hidden": "!data.liveHttps",
                    "label": "Public certificate",
                    "xl": 3
                },
                "liveCertPrivate": {
                    "type": "certificate",
                    "certType": "private",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "hidden": "!data.liveHttps",
                    "label": "Private key",
                    "xl": 3
                },
                "liveHttpsInfo": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "hidden": "!data.liveHttps",
                    "text": "Certificates come from the ioBroker system settings (Certificates). With HTTPS the adapter additionally uses the player port + 1 on 127.0.0.1 internally.",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "liveSecurity": {
                    "type": "staticText",
                    "newLine": true,
                    "xs": 12,
                    "text": "The player port has no login. Only use it in your home network — do not forward these ports to the internet.",
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "options": {
            "type": "panel",
            "label": "Options",
            "items": {
                "pollIntervalMin": {
                    "type": "number",
                    "label": "Cloud poll interval (minutes)",
                    "help": "Realtime events arrive via push/MQTT/P2P anyway; the poll catches values that are only reported to the cloud.",
                    "min": 1,
                    "max": 120,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "cacheTtlSec": {
                    "type": "number",
                    "label": "Value cache TTL (seconds)",
                    "min": 5,
                    "max": 3600,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "eventResetSec": {
                    "type": "number",
                    "label": "Reset event states after (seconds, 0 = never)",
                    "min": 0,
                    "max": 3600,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "saveSnapshots": {
                    "type": "checkbox",
                    "label": "Save camera thumbnail on motion/person/doorbell events",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "snapshotDataUrl": {
                    "type": "checkbox",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "label": "Also provide the snapshot as data URL (snapshot.dataUrl, for vis image/HTML widgets)",
                    "lg": 8,
                    "xl": 8
                },
                "ffmpegPath": {
                    "type": "text",
                    "label": "Path to ffmpeg (optional; default: ffmpeg on PATH, else bundled)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "excludeDevices": {
                    "type": "text",
                    "label": "Ignore devices (serial numbers, comma separated)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "openudid": {
                    "type": "text",
                    "label": "Client identity (openudid, optional)",
                    "help": "Leave empty — a stable random identity is generated per instance.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "sdkDebug": {
                    "type": "checkbox",
                    "label": "Verbose SDK logging (info/warn of the SDK in the ioBroker log)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
